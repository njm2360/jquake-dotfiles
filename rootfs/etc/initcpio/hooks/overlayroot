#!/usr/bin/env bash

run_hook() {
    # overlayroot=0 指定時は overlay を張らない (緊急復旧用)
    if [ "${overlayroot}" = "0" ]; then
        return 0
    fi
    mount_handler="overlayroot_mount_handler"
}

overlayroot_mount_handler() {
    local newroot="$1"
    local rootdev

    # tmpfs サイズ上限 (環境に合わせて調整)
    local tmpfs_size="${overlayroot_size:-1G}"

    rootdev=$(resolve_device "${root}") || _overlayroot_fail "resolve_device failed for ${root}"

    mkdir -p /ovl_lower || _overlayroot_fail "mkdir /ovl_lower failed"
    mount -t ext4 -o ro,noatime "$rootdev" /ovl_lower \
        || _overlayroot_fail "mount lower (${rootdev}) failed"

    mkdir -p /ovl_tmpfs || _overlayroot_fail "mkdir /ovl_tmpfs failed"
    mount -t tmpfs -o "mode=0755,size=${tmpfs_size},nosuid,nodev" \
        overlayroot-tmpfs /ovl_tmpfs \
        || _overlayroot_fail "mount tmpfs failed"

    mkdir -p /ovl_tmpfs/upper /ovl_tmpfs/work \
        || _overlayroot_fail "mkdir upper/work failed"
    chmod 0755 /ovl_tmpfs/upper /ovl_tmpfs/work

    mount -t overlay overlay \
        -o lowerdir=/ovl_lower,upperdir=/ovl_tmpfs/upper,workdir=/ovl_tmpfs/work \
        "$newroot" \
        || _overlayroot_fail "mount overlay failed"

    mkdir -p "$newroot/mnt/rootfs.lower" \
        || _overlayroot_fail "mkdir rootfs.lower failed"
    mount --bind /ovl_lower "$newroot/mnt/rootfs.lower" \
        || _overlayroot_fail "bind mount lower failed"

    mkdir -p "$newroot/mnt/rootfs.upper" \
        || _overlayroot_fail "mkdir rootfs.upper failed"
    mount --bind /ovl_tmpfs "$newroot/mnt/rootfs.upper" \
        || _overlayroot_fail "bind mount rootfs.upper failed"
}

_overlayroot_fail() {
    echo "overlayroot: $*" >&2
    echo "overlayroot: dropping to emergency shell. exit to retry default mount." >&2
    launch_interactive_shell
    return 1
}
