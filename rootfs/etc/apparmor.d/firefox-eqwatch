abi <abi/4.0>,
include <tunables/global>

profile firefox-eqwatch /usr/lib/firefox/firefox flags=(attach_disconnected) {
  capability,
  network,
  unix,
  dbus,
  signal,
  ptrace,
  mount,
  umount,
  remount,
  pivot_root,
  userns,
  io_uring,
  mqueue,
  file,

  deny @{HOME}/[^.]** rwlkmx,
  deny @{HOME}/.ssh/** rwlkmx,
  deny @{HOME}/.config/*.env rwlkmx,
  deny @{HOME}/.config/JQuake/** rwlkmx,
  deny @{HOME}/.config/tigervnc/** rwlkmx,
  deny /etc/msmtprc rwlkmx,

  # ~/.cache を塞ぐとプロファイルを開けない
  deny @{HOME}/* w,
  deny @{HOME}/.{config,java,local,pki}/** w,

  include if exists <local/firefox-eqwatch>
}
