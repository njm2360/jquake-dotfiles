#!/usr/bin/env bash
# 地震監視PCの状態レポートをメール送信する (systemd timer から週次起動)
# -n: 送信せず標準出力に表示
set -uo pipefail

DRY_RUN=0
[ "${1:-}" = "-n" ] && DRY_RUN=1

TO="${HEALTH_REPORT_TO:-}"
(( DRY_RUN )) || [ -n "$TO" ] || { echo "HEALTH_REPORT_TO が未設定" >&2; exit 1; }
DEVICES="${HEALTH_REPORT_DEVICES:-}"
RUN_SELFTEST="${HEALTH_REPORT_SELFTEST:-1}"
EQ_USER="${HEALTH_REPORT_USER:-eqwatch}"
HOST="$(cat /etc/hostname 2>/dev/null || echo unknown)"

EQ_UID=$(id -u "$EQ_USER" 2>/dev/null || echo "")
EQ_HOME=$(getent passwd "$EQ_USER" | cut -d: -f6)

worst=0
issues=()
body=""

# issue <0:情報 1:警告 2:異常> <メッセージ>
issue() {
  (( $1 > worst )) && worst=$1
  case $1 in 1) issues+=("[警告] $2") ;; 2) issues+=("[異常] $2") ;; esac
}
section() { body+=$'\n'"========== $1"$'\n'; }
line() { body+="$*"$'\n'; }
usage_pct() { df --output=pcent "$1" 2>/dev/null | tail -1 | tr -dc '0-9'; }
user_systemctl() { systemctl --user -M "$EQ_USER@" "$@"; }

section "稼働状況"
line "カーネル: $(uname -r)"
installed=$(pacman -Q linux-lts 2>/dev/null | awk '{print $2}')
if [ -n "$installed" ] && [ "$(uname -r)" != "${installed}-lts" ]; then
  line "  インストール済み: ${installed}-lts (再起動待ち)"
  issue 1 "カーネル更新後に再起動されていない"
fi
line "起動: $(uptime -s) ($(uptime -p))"
line "負荷: $(cut -d' ' -f1-3 /proc/loadavg)"
line "メモリ: $(free -m | awk '/^Mem:/{printf "使用 %dM / %dM (空き %dM)", $3, $2, $7}')"
temp=$(for z in /sys/class/thermal/thermal_zone*; do
         [ "$(cat "$z/type")" = x86_pkg_temp ] && echo $(( $(cat "$z/temp") / 1000 ))
       done | head -1)
if [ -n "$temp" ]; then
  line "CPU温度: ${temp}℃"
  (( temp >= 85 )) && issue 1 "CPU温度が高い (${temp}℃)"
fi
line "Secure Boot: $(bootctl status 2>/dev/null | sed -n 's/^ *Secure Boot: //p' | head -1)"
line "ウォッチドッグ: $(systemctl show -p RuntimeWatchdogUSec --value)"

section "ルートファイルシステム"
if mountpoint -q /mnt/rootfs.upper 2>/dev/null; then
  line "モード: OverlayFS"
  upper=$(usage_pct /mnt/rootfs.upper)
  line "上層 (tmpfs): $(df -h /mnt/rootfs.upper | awk 'NR==2{printf "使用 %s / %s (%s)", $3, $2, $5}')"
  if   (( upper >= 90 )); then issue 2 "OverlayFS 上層の使用率 ${upper}%"
  elif (( upper >= 70 )); then issue 1 "OverlayFS 上層の使用率 ${upper}%"
  fi
  line "上層の使用量上位:"
  body+="$(du -xh --max-depth=3 /mnt/rootfs.upper/upper 2>/dev/null | sort -rh | sed -n '2,6p' | sed 's/^/  /')"$'\n'
else
  line "モード: RW (overlayroot=0)"
  issue 1 "RW モードで稼働している"
fi
for m in /mnt/rootfs.lower / /boot /var/log /tmp; do
  mountpoint -q "$m" 2>/dev/null || continue
  [ "$m" = / ] && mountpoint -q /mnt/rootfs.upper 2>/dev/null && continue
  p=$(usage_pct "$m")
  line "$m: $(df -h "$m" | awk 'NR==2{printf "使用 %s / %s (%s)", $3, $2, $5}')"
  (( p >= 90 )) && issue 1 "$m の使用率 ${p}%"
done

section "SSD (SMART)"
[ -n "$DEVICES" ] || DEVICES=$(lsblk -dpno NAME,TYPE | awk '$2=="disk"{printf "%s ", $1}')
for dev in $DEVICES; do
  [ -b "$dev" ] || continue
  rc=0
  out=$(smartctl -H -A -l selftest "$dev" 2>&1) || rc=$?

  # smartctl の終了コードはビットマスク:
  #   bit0-2 取得失敗 / bit3-4 故障予告・しきい値割れ / bit5-7 過去の異常・エラーログ・テスト失敗
  if   (( rc & 7   )); then st="取得失敗"; issue 2 "$dev SMART 取得失敗"
  elif (( rc & 24  )); then st="異常";     issue 2 "$dev SMART 異常"
  elif (( rc & 224 )); then st="警告";     issue 1 "$dev SMART 警告"
  else                     st="正常"
  fi

  model=$(smartctl -i "$dev" 2>/dev/null | sed -n 's/^Device Model: *//p')
  line "--- $dev [$st] ${model:-不明} (終了コード: $rc)"
  line "$(printf '%s\n' "$out" | grep -iE 'overall-health|SMART Health Status')"
  line "$(printf '%s\n' "$out" | grep -iE 'Reallocated_Sector|Power_On_Hours|Power_Cycle|Wear_Leveling|Current_Pending|Offline_Uncorrectable|UDMA_CRC|Total_LBAs_Written|Temperature|Percentage Used|Data Units Written' || echo '(該当属性なし)')"
  line "セルフテスト履歴(直近):"
  line "$(printf '%s\n' "$out" | sed -n '/Self-test log/,/^$/p' | sed -n '3,6p')"
done

section "JQuake"
if [ -n "$EQ_UID" ]; then
  state=$(user_systemctl show jquake -p ActiveState --value 2>/dev/null)
  since=$(user_systemctl show jquake -p ActiveEnterTimestamp --value 2>/dev/null)
  restarts=$(user_systemctl show jquake -p NRestarts --value 2>/dev/null)
  line "状態: ${state:-不明} (起動: ${since:-不明}, 再起動回数: ${restarts:-不明})"
  [ "$state" = active ] || issue 2 "jquake.service が active でない (${state:-不明})"
  java=$(ps -u "$EQ_USER" -o rss=,etime=,args= | awk '/JQuake\.jar/{printf "RSS %dM, 稼働 %s", $1/1024, $2; exit}')
  line "Java: ${java:-プロセスなし}"
fi

section "DM-D.S.S"
api_key=$(sed -n 's/^API_KEY=["'\'']\{0,1\}\([^"'\'']*\).*/\1/p' "$EQ_HOME/JQuake/.env" 2>/dev/null)
if [ -n "$api_key" ]; then
  # API キーがプロセス一覧に出ないよう stdin から渡す
  if resp=$(curl -fsS --connect-timeout 5 --max-time 10 -K - "https://api.dmdata.jp/v2/socket?status=open" <<<"user = \"${api_key}:\"" 2>&1); then
    n=$(jq '.items | length' <<<"$resp")
    line "WebSocket 接続数: $n"
    body+="$(jq -r '.items[] | "  \(.appName) id=\(.id) 開始=\(.start[0:19] + "Z" | fromdate | strflocaltime("%Y-%m-%d %H:%M:%S"))"' <<<"$resp")"$'\n'
    (( n == 0 )) && issue 2 "DM-D.S.S の WebSocket 接続なし"
  else
    line "API 取得失敗: $resp"
    issue 1 "DM-D.S.S API 取得失敗"
  fi
else
  line "API_KEY 未設定のため省略"
fi

section "systemd"
failed=$(systemctl --failed --no-legend --plain | awk '{print $1}')
[ -n "$EQ_UID" ] && failed+=$'\n'$(user_systemctl --failed --no-legend --plain 2>/dev/null | awk '{print "(user) " $1}')
failed=$(sed '/^$/d' <<<"$failed")
if [ -n "$failed" ]; then
  line "失敗ユニット:"
  line "$(sed 's/^/  /' <<<"$failed")"
  issue 1 "失敗しているユニットあり"
else
  line "失敗ユニット: なし"
fi
errs=$(journalctl -b -p err -q --no-pager 2>/dev/null | wc -l)
oom=$(journalctl -k -b -q --no-pager 2>/dev/null | grep -ci 'out of memory')
line "今回起動後のエラーログ: ${errs}件 (OOM: ${oom}件)"
(( oom > 0 )) && issue 1 "OOM Killer が発動している"
if (( errs > 0 )); then
  line "直近のエラー:"
  line "$(journalctl -b -p err -q --no-pager -o short 2>/dev/null | tail -5 | cut -c1-200 | sed 's/^/  /')"
fi

section "ネットワーク・時刻"
gw=$(ip route show default | awk '{print $3; exit}')
if [ -n "$gw" ] && ping -c 3 -W 2 -q "$gw" >/dev/null 2>&1; then
  line "ゲートウェイ $gw: 疎通OK"
else
  line "ゲートウェイ ${gw:-なし}: 疎通NG"
  issue 1 "ゲートウェイに疎通しない"
fi
if resolvectl query dmdata.jp >/dev/null 2>&1; then
  line "DNS (dmdata.jp): OK"
else
  line "DNS (dmdata.jp): NG"
  issue 1 "dmdata.jp の名前解決に失敗"
fi
ntp=$(timedatectl show -p NTPSynchronized --value)
line "NTP 同期: $ntp ($(timedatectl show-timesync -p ServerName --value 2>/dev/null))"
[ "$ntp" = yes ] || issue 1 "NTP 未同期"

section "音声"
if [ -n "$EQ_UID" ]; then
  as_eq() { runuser -u "$EQ_USER" -- env XDG_RUNTIME_DIR="/run/user/$EQ_UID" "$@"; }
  sink=$(as_eq wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | sed -n 's/^ *\* node\.description = "\(.*\)"/\1/p')
  line "出力先: ${sink:-取得失敗}"
  line "音量: $(as_eq wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo 取得失敗)"
  as_eq wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED && issue 1 "音声がミュートされている"
fi

case $worst in
  0) status="正常" ;;
  1) status="警告" ;;
  *) status="異常" ;;
esac

summary="判定: $status"$'\n'
if (( ${#issues[@]} )); then
  summary+="$(printf '%s\n' "${issues[@]}")"$'\n'
fi

subject="[${status}] ${HOST} 状態レポート"
report="${summary}${body}"$'\n'"生成: $(date '+%Y-%m-%d %H:%M:%S %Z')"

if (( DRY_RUN )); then
  printf 'Subject: %s\n\n%s\n' "$subject" "$report"
  exit 0
fi

# 日本語件名は RFC 2047 で MIME エンコードしないと文字化けする
subj_enc="=?UTF-8?B?$(printf '%s' "$subject" | base64 -w0)?="

if ! {
    printf 'To: %s\n' "$TO"
    printf 'Subject: %s\n' "$subj_enc"
    printf 'MIME-Version: 1.0\n'
    printf 'Content-Type: text/plain; charset=UTF-8\n'
    printf 'Content-Transfer-Encoding: 8bit\n'
    printf '\n'
    printf '%s\n' "$report"
  } | msmtp "$TO"; then
  echo "メール送信に失敗しました" >&2
  exit 1
fi

echo "送信しました: $TO  (判定: $status)"

# 次回レポート用に短時間セルフテストを開始しておく
if [ "$RUN_SELFTEST" = "1" ]; then
  for dev in $DEVICES; do
    [ -b "$dev" ] && smartctl -t short "$dev" >/dev/null 2>&1 || true
  done
fi
