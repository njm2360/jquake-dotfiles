#!/usr/bin/env bash
# DM-D.S.S の WebSocket は JQuake の 1 本だけの前提
set -uo pipefail

case ${1:-} in
  count|close) ;;
  *) echo "usage: dmdata-socket count|close" >&2; exit 2 ;;
esac

source ~/.config/jquake.env || exit 1
[ -n "${API_KEY:-}" ] || { echo "API_KEY が未設定" >&2; exit 1; }

BASE_URL="https://api.dmdata.jp/v2"

# API キーがプロセス一覧に出ないよう stdin から渡す
api() { curl -fsS --connect-timeout 5 --max-time 10 -K - "$@" <<<"user = \"${API_KEY}:\""; }

open=$(api "$BASE_URL/socket?status=open") || exit 1

case $1 in
  count)
    jq '.items | if type == "array" then length else error("items がない") end' <<<"$open"
    ;;
  close)
    rc=0
    for id in $(jq -r '.items[].id' <<<"$open"); do
      if api -X DELETE "$BASE_URL/socket/$id" >/dev/null; then
        echo "closed $id" >&2
      else
        rc=1
      fi
    done
    exit $rc
    ;;
esac
